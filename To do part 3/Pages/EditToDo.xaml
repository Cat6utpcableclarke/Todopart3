<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="To_do_part_3.EditToDo"
             BackgroundColor="WhiteSmoke"
             Title="Edit Current Task">
    <ContentPage.Content>
        <VerticalStackLayout>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <ImageButton 
                 Grid.Column="0"
                 Source="back_button_icon.png"
                 Clicked="OnClickReturn"
                 MaximumWidthRequest="20"
                 MaximumHeightRequest="40"
                 VerticalOptions="Center"
                 HorizontalOptions="Start"
                 BackgroundColor="Transparent"
                 Margin="40,20,10,5"
                 />
                <Label 
                 Grid.Column="1"
                 Grid.ColumnSpan="3"
                 Text="Edit Ongoing Task"
                 VerticalOptions="Center" 
                 HorizontalOptions="Start" 
                 FontSize="Large"
                 FontAttributes="Bold"
                 Margin="0,20,50,5"/>
            </Grid>

            <BoxView HeightRequest="1" Color="Gray" Margin="25,10,25,10"/>

            <VerticalStackLayout Margin="20,10,20,0" Spacing="15">
                <Border
                 BackgroundColor="#C5D9E2" 
                 StrokeShape="RoundRectangle 15"
                 Padding="10">
                    <VerticalStackLayout>
                        <Entry Text="{Binding ItemName}"
                        FontSize="Medium"
                        FontAttributes="Bold"
                        TextColor="Black"/>
                        <Border 
                         BackgroundColor="#70f5f5f5" 
                         StrokeShape="RoundRectangle 10"
                         Padding="10" 
                         Margin="0,5,0,0"  
                         HeightRequest="300">
                            <VerticalStackLayout>
                                <Editor Text="{Binding ItemDescription}" FontSize="Small" FontAttributes="Bold" HeightRequest="300"/>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- Action Buttons -->
                <Button Text="Update" BackgroundColor="#0F8B8D" TextColor="White" Clicked="UpdateTask" CommandParameter="{Binding .}"/>
                <Button Text="Complete" BackgroundColor="#EC9A29" TextColor="White" Clicked="CompleteTask" CommandParameter="{Binding .}"/>
                <Button Text="Delete" BackgroundColor="#A8201A" TextColor="White" Clicked="DeleteTask" CommandParameter="{Binding .}"/>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ContentPage.Content>
</ContentPage>