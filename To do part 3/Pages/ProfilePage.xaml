<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="To_do_part_3.ProfilePage"
             BackgroundColor="WhiteSmoke"
             Title="ProfilePage">
    <VerticalStackLayout>

 
    <Label 
        Grid.Column="1"
        Text="Profile"
        VerticalOptions="Center" 
        HorizontalOptions="Center" 
        FontSize="Large"
        FontAttributes="Bold"
        Margin="0,20,0,5"/>

        <BoxView HeightRequest="1" Color="#C5D9E2" Margin="25,10,25,10"/>

        <Image
            MaximumHeightRequest="260"
            MaximumWidthRequest="260"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            Margin="0,25,0,0"
            Source="default_profile_pic.png"/>
        
        <VerticalStackLayout
            Margin="0,25,0,0">
            <Label x:Name="Name"
                Text=""
                FontSize="25"
                HorizontalOptions="Center"
                VerticalOptions="Center"/>
            <Label
                x:Name="Desc"
                Text="Tell us about yourself!!"
                Margin="50,10,50,0"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                FontSize="15"/>
        </VerticalStackLayout>
        <Button Text="Sign Out" BackgroundColor="#A8201A" Clicked="SignOut" TextColor="White" Margin="30,30,30,10"/>
    </VerticalStackLayout>
</ContentPage>