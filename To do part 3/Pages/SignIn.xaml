<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="To_do_part_3.SignIn"
             BackgroundColor="WhiteSmoke"
             Title="SignIn">
    <VerticalStackLayout Padding="30" Spacing="20">
        <Image
            Source="logo.png"
            WidthRequest="180"
            HeightRequest="180"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            Margin="0,110,0,20"/>

        <Border Margin="0,0,0,5" Padding="3" StrokeShape="RoundRectangle 15" StrokeThickness="1" BackgroundColor="LightGray">
            <Entry Placeholder="Email Address" PlaceholderColor="Gray" x:Name="Email" />
        </Border>

        <Border Margin="0,0,0,5" Padding="3" StrokeShape="RoundRectangle 15" StrokeThickness="1" BackgroundColor="LightGray">
            <Entry Placeholder="Password" IsPassword="True" PlaceholderColor="Gray" x:Name="Password" />
        </Border>

        <Button 
            Text="Sign In"
            BackgroundColor="#0F8B8D"
            TextColor="White"
            HeightRequest="50"
            CornerRadius="25"
            Clicked="SignInClicked"
            Margin="0,0,0,10"/>

        <Button 
            Text="Sign Up"
            BackgroundColor="#EC9A29"
            TextColor="White"
            HeightRequest="50"
            CornerRadius="25"
            Clicked="SignUpClicked"
            HorizontalOptions="FillAndExpand"
            VerticalOptions="Center"/>
    </VerticalStackLayout>
</ContentPage>