<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="To_do_part_3.ToDoPage"
             BackgroundColor="WhiteSmoke"
             Title="ToDo">
    <ContentPage.Content>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <VerticalStackLayout Grid.Row="0">
                <Label 
                    Text="To Dos"
                    VerticalOptions="Center" 
                    HorizontalOptions="Center" 
                    FontSize="Large"
                    TextColor="Black"
                    FontAttributes="Bold"
                    Margin="0,20,0,5"/>

                <BoxView HeightRequest="1" Color="#C5D9E2" Margin="25,10,25,10"/>
            </VerticalStackLayout>

            <ListView 
                x:Name="ToDos" 
                Grid.Row="1"
                HorizontalOptions="Fill" 
                VerticalOptions="Fill" 
                SeparatorVisibility="None" 
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <ViewCell>
                            <Grid RowSpacing="10" Margin="3">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"  />
                                </Grid.ColumnDefinitions>

                                <Border  Grid.Row="0"  Grid.Column="0" BackgroundColor="#50C5D9E2"  Padding="15" Margin="15"  HeightRequest="80" Stroke="Transparent">

                                    <Grid HorizontalOptions="Fill" VerticalOptions="Fill">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Label Grid.Row="0" Grid.Column="0" Text="{Binding ItemName}" FontSize="Large" VerticalOptions="Center" HorizontalOptions="Start" TextColor="Black" LineBreakMode="TailTruncation"/>
                                        <ImageButton
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Source="edit.png"
                                            Clicked="Edit_Clicked"
                                            CommandParameter="{Binding .}"
                                            HorizontalOptions="End"
                                            VerticalOptions="Center"
                                            BackgroundColor="Transparent"
                                            MaximumHeightRequest="20"
                                            MaximumWidthRequest="20"
                                            Aspect="AspectFit"
                                            Padding="0"
                                            Margin="10"/>
                                        <ImageButton
                                            Grid.Row="0"
                                            Grid.Column="2"
                                            Source="delete.png"
                                            Clicked="Delete_Clicked"
                                            CommandParameter="{Binding .}"
                                            HorizontalOptions="End"
                                            VerticalOptions="Center"
                                            BackgroundColor="Transparent"
                                            MaximumHeightRequest="20"
                                            MaximumWidthRequest="20"
                                            Aspect="AspectFit"
                                            Padding="0"
                                            Margin="10"/>
                                        <ImageButton
                                            Grid.Row="0"
                                            Grid.Column="3"
                                            Source="complete.png"
                                            Clicked="Done_Clicked"
                                            CommandParameter="{Binding .}"
                                            HorizontalOptions="End"
                                            VerticalOptions="Center"
                                            BackgroundColor="Transparent"
                                            MaximumHeightRequest="20"
                                            MaximumWidthRequest="20"
                                            Aspect="AspectFit"
                                            Padding="0"
                                            Margin="10"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Button 
                Text="+" 
                Clicked="Add_Clicked"
                WidthRequest="60"
                HeightRequest="60"
                FontSize="30"
                CornerRadius="25"
                BackgroundColor="#0F8B8D"
                TextColor="White"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="0,0,20,20"  
                Grid.RowSpan="2" />

            <Grid
            x:Name="LoadingOverlay"
            BackgroundColor="#80000000"  
            IsVisible="False"
            InputTransparent="False"
            Grid.RowSpan="2"
            HorizontalOptions="Fill"
            VerticalOptions="Fill">

                <ActivityIndicator
                x:Name="LoadingIndicator"
                IsRunning="True"
                Color="White"
                WidthRequest="60"
                HeightRequest="60"
                HorizontalOptions="Center"
                VerticalOptions="Center" />

            </Grid>
        </Grid>
    </ContentPage.Content>
</ContentPage>